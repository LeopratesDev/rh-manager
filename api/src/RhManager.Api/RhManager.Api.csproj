      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RhManager.Application\RhManager.Application.csproj" />
    <ProjectReference Include="..\RhManager.Infrastructure\RhManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
