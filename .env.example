# Copie para .env e troque os valores antes de rodar "docker compose up".
# Senha do usuário sa do SQL Server: mínimo de 8 caracteres, com maiúscula, minúscula, número e símbolo.
MSSQL_SA_PASSWORD=Troque-esta-Senha1!
# Chave de assinatura do JWT: mínimo de 32 caracteres.
JWT_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
